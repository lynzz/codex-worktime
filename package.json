{
  "name": "codex-worktime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @codex-worktime/web",
    "analyzer": "npm run start -w @codex-worktime/analyzer",
    "serve": "tsx packages/analyzer/src/index.ts manual serve"
  },
  "dependencies": {
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1"
  }
}
